    "format": "prettier --write client scripts tests vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "clsx": "2.1.1",
    "framer-motion": "12.23.22",
    "lucide-react": "0.453.0",
    "next-themes": "0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
